<?xml version="1.0" encoding="UTF-8"?>
<!--
  Textos de la interfaz. Un bloque <language> por idioma; el atributo "code" es el que se
  guarda en los ajustes y "flag" indica qué bandera se dibuja en el menú (ver flags.py).
  Los textos admiten marcadores {nombre} que se rellenan desde el código.
  El orden de los bloques es el orden en que se recorren al pulsar la bandera.
-->
<translations default="es">
  <language code="es" name="Español" flag="es">
    <text key="menu.subtitle">Atrapa enemigos en burbujas y revienta</text>
    <text key="menu.play">Jugar (nivel {level})</text>
    <text key="menu.scores">Puntuaciones</text>
    <text key="menu.quit">Salir</text>
    <text key="scores.title">Puntuaciones</text>
    <text key="scores.empty">Aún no hay partidas</text>
    <text key="scores.back">Toca para volver</text>
    <text key="scores.level">N{level}</text>
    <text key="hud.score">Puntos {score}</text>
    <text key="hud.level">Nivel {level}</text>
    <text key="hud.lives">Vidas {lives}</text>
    <text key="star.kill_all">Mata a todos los enemigos para terminar el nivel</text>
    <text key="win.title">Nivel {level} completado</text>
    <text key="win.game">¡Has ganado el juego!</text>
    <text key="win.time">Tiempo: {time}</text>
    <text key="win.points">Puntos conseguidos: {points}</text>
    <text key="win.total">Total: {score}</text>
    <text key="lost.title">Fin de la partida</text>
    <text key="lost.points">Puntos: {score}</text>
    <text key="common.continue">Toca para continuar</text>
    <text key="player.default">Jugador</text>
  </language>
  <language code="en" name="English" flag="uk">
    <text key="menu.subtitle">Trap enemies in bubbles and pop them</text>
