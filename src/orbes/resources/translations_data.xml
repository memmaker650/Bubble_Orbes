<?xml version="1.0" encoding="UTF-8"?>
<!--
  Textos de la interfaz. Un bloque <language> por idioma; el atributo "code" es el que se
  guarda en los ajustes y "flag" indica qué bandera se dibuja en el menú (ver flags.py).
  Los textos admiten marcadores {nombre} que se rellenan desde el código.
  El orden de los bloques es el orden en que se recorren al pulsar la bandera.
-->
